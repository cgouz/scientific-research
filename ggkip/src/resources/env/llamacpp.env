# Test setup on the GPU server: llama-server with Qwen3-8B, Uzbekistan only,
# scheduler off (crawls are started with POST /v1/sites/{id}/crawl).
APP_ENV=local

HTTP_HOST=0.0.0.0
HTTP_PORT=8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ggkip
DB_USER=ggkip
DB_PASSWORD=ggkip
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20

RESOURCES_DIR=src/resources
MIGRATE_ON_START=true
SEED_ON_START=true
SEED_COUNTRIES=UZ

SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SEC=60
SCHEDULER_MAX_SITES=2
SCHEDULER_FAILURE_RETRY_SEC=1800

CRAWLER_WORKERS=4
CRAWLER_TIMEOUT_SEC=30
CRAWLER_MAX_BODY_BYTES=5242880
CRAWLER_USER_AGENT=GGKIPBot/0.1 (+https://example.org/bot)

# llama-server started with: -c 65536 -np 4 --jinja  (16k tokens per slot)
LLM_RUNTIME=llamacpp
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3-8b-q8_0
LLM_API_KEY=
LLM_TIMEOUT_SEC=300
LLM_WORKERS=4
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_TOKENS=3072
