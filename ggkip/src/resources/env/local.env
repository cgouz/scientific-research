# Local development settings. Real environment variables override values in this file.
APP_ENV=local

HTTP_HOST=0.0.0.0
HTTP_PORT=8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ggkip
DB_USER=ggkip
DB_PASSWORD=ggkip
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20

RESOURCES_DIR=src/resources
MIGRATE_ON_START=true
SEED_ON_START=true

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SEC=60
SCHEDULER_MAX_SITES=2
SCHEDULER_FAILURE_RETRY_SEC=1800

# Sites crawled at the same time by the scheduler, manual triggers and crawl
# batches together; a batch site waits for a free slot. Defaults to SCHEDULER_MAX_SITES.
CRAWL_MAX_SITES=8
# Inside a crawl batch (POST /v1/crawl-batches): sites of one country at once.
CRAWL_MAX_SITES_PER_COUNTRY=4

CRAWLER_WORKERS=4
CRAWLER_TIMEOUT_SEC=30
CRAWLER_MAX_BODY_BYTES=5242880
CRAWLER_USER_AGENT=GGKIPBot/0.1 (+https://example.org/bot)

# vllm or llamacpp (the --llm-runtime flag overrides this)
LLM_RUNTIME=vllm
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_TIMEOUT_SEC=180
LLM_WORKERS=4
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_TOKENS=4096
