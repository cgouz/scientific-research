{
  "max_pages_per_run": 500,
  "max_depth": 3,
  "max_sitemaps": 20,
  "max_redirects": 5,
  "max_retries": 2,
  "requests_per_second": 2.0,
  "min_text_chars": 200,
  "min_text_words": 30,
  "allowed_content_types": [
    "text/html",
    "application/xhtml+xml",
    "text/plain",
    "application/json"
  ],
  "skip_extensions": [
    ".pdf",
    ".doc",
    ".docx",
    ".xls",
    ".xlsx",
    ".ppt",
    ".pptx",
    ".odt",
    ".ods",
    ".rtf",
    ".zip",
    ".rar",
    ".7z",
    ".gz",
    ".tar",
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".svg",
    ".webp",
    ".bmp",
    ".ico",
    ".tif",
    ".tiff",
    ".mp3",
    ".wav",
    ".ogg",
    ".mp4",
    ".avi",
    ".mov",
    ".mkv",
    ".webm",
    ".exe",
    ".msi",
    ".apk",
    ".dmg",
    ".iso",
    ".css",
    ".js",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot"
  ],
  "tracking_params": [
    "gclid",
    "fbclid",
    "yclid",
    "msclkid",
    "dclid",
    "mc_cid",
    "mc_eid",
    "_ga",
    "_gl",
    "igshid"
  ],
  "tracking_param_prefixes": [
    "utm_"
  ]
}
